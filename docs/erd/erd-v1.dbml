Project tracktory {
  database_type: 'MySQL'
  Note: '캡스톤'
}

// ============================================================
// 계정
// ============================================================
Table user {
  id            bigint       [pk, increment]
  email         varchar(255) [unique, not null]  // 로그인 이메일
  password_hash varchar(255) [not null]          // 해시된 비밀번호
  created_at    timestamp    [default: `now()`, not null]
  updated_at    timestamp    [default: `now()`, not null]
}

// ============================================================
// 프로필 (온보딩 결과)
// ============================================================
Table user_profile {
  id bigint [pk, increment]
  user_id bigint [ref: - user.id]   // 1:1
  department_id int [ref: > department.id]  // 소속 (학부)
  student_id char(7) [unique, not null]   // 학번
  current_year tinyint [not null] // 현재 학년 (1~4)
  name varchar(50) [not null] // 이름
  profile_image_url varchar(500)
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]
}

Table user_track {               // User ↔ Track (1트랙/2트랙 — 구분은 필드)
  id bigint [pk, increment]
  user_id bigint [ref: > user.id]
  track_id int [ref: > track.id]
  track_order tinyint [not null]
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]
  indexes {
    (user_id, track_id) [unique]
    (user_id, track_order) [unique]
  }
}

Table user_interest {            // User ↔ Interest (1~5)
  id bigint [pk, increment]
  user_id bigint [ref: > user.id]
  interest_id int [ref: > interest.id]
  created_at timestamp [default: `now()`, not null]
  indexes { (user_id, interest_id) [unique] }
}

Table user_dev_field {           // User ↔ DevField (1~3)
  id bigint [pk, increment]
  user_id bigint [ref: > user.id]
  dev_field_id int [ref: > dev_field.id]
  created_at timestamp [default: `now()`, not null]
  indexes { (user_id, dev_field_id) [unique] }
}

Table user_company_type {        // User ↔ CompanyType
  id bigint [pk, increment]
  user_id bigint [ref: > user.id]
  company_type_id int [ref: > company_type.id]
  created_at timestamp [default: `now()`, not null]
  indexes { (user_id, company_type_id) [unique] }
}

Table user_work_value {          // User ↔ WorkValue (최대 3)
  id bigint [pk, increment]
  user_id bigint [ref: > user.id]
  work_value_id int [ref: > work_value.id]
  created_at timestamp [default: `now()`, not null]
  indexes { (user_id, work_value_id) [unique] }
}

Table user_tech_stack {          // 공부해본 기술 (UI: Python/Java/...)
  id bigint [pk, increment]
  user_id bigint [ref: > user.id]
  tech_stack_id int [ref: > tech_stack.id]
  created_at timestamp [default: `now()`, not null]
  indexes { (user_id, tech_stack_id) [unique] }
}

Table user_tech_stack_custom {  // 자유 입력값
  id bigint [pk, increment]
  user_id bigint [ref: > user.id]
  label varchar(40) [not null]
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]
  indexes { (user_id, label) [unique] }
}

Table user_completed_subject {   // 이수 과목 (속성 붙음 — 학년/학기)
  id bigint [pk, increment]
  user_id bigint [ref: > user.id]
  subject_id int [ref: > subject.id]
  year tinyint [not null]
  semester tinyint [not null]
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]
  indexes { (user_id, subject_id) [unique] }
}

// ============================================================
// 조직 계층
// ============================================================
Table college {
  id bigint [pk, increment]
  name varchar(255) [unique, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table department {
  id bigint [pk, increment]
  college_id bigint [ref: > college.id, not null]   // ON DELETE: RESTRICT (카탈로그 FK)
  name varchar(255) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes {
    (college_id, name) [unique]
  }
}

Table track {
  id bigint [pk, increment]
  department_id bigint [ref: > department.id, not null]   // ON DELETE: RESTRICT (카탈로그 FK)
  name varchar(255) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes {
    (department_id, name) [unique]
  }
}

// ============================================================
// 교과
// ============================================================
Enum subject_semester {
  first
  second
  both
}
Table subject {
  id bigint [pk, increment]
  name varchar(255) [not null]
  description text [not null]
  credit decimal(2,1) [not null]
  semester subject_semester [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// 졸업요건 카테고리 (전공기초/필수/선택)
Enum subject_type {
  basic
  required
  elective
}

// 커리큘럼 학습 단계
Enum subject_stage {
  foundation
  core
  applied
  industry
}

Table track_subject {            // Track ↔ Subject (필수/선택은 필드)
  id bigint [pk, increment]
  track_id bigint [ref: > track.id, not null]       // ON DELETE: RESTRICT (카탈로그 FK)
  subject_id bigint [ref: > subject.id, not null]   // ON DELETE: RESTRICT (카탈로그 FK)
  type subject_type [not null]
  stage subject_stage [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes { (track_id, subject_id) [unique] }
}

Enum prerequisite_strength {
  required
  recommended
}

Table subject_prerequisite {     // Subject self-ref (선수과목)
  id bigint [pk, increment]
  subject_id bigint [ref: > subject.id, not null]      // 후수 — ON DELETE: RESTRICT (카탈로그 FK)
  prerequisite_id bigint [ref: > subject.id, not null] // 선수 — ON DELETE: RESTRICT (카탈로그 FK)
  strength prerequisite_strength [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes { (subject_id, prerequisite_id) [unique] }
}

Table subject_job {              // 과목 상세 "관련 직무"
  id bigint [pk, increment]
  subject_id bigint [ref: > subject.id, not null]   // ON DELETE: RESTRICT (카탈로그 FK)
  job_id bigint [ref: > job.id, not null]           // ON DELETE: RESTRICT (카탈로그 FK)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes { (subject_id, job_id) [unique] }
}

// ============================================================
// 진로
// ============================================================
Table job {
  id bigint [pk, increment]
  name varchar(255) [not null]
  description text [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table tech_stack {
  id bigint [pk, increment]
  name varchar(255) [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table job_dev_field {
  id bigint [pk, increment]
  dev_field_id bigint [ref: > dev_field.id, not null]   // ON DELETE: RESTRICT (카탈로그 FK)
  job_id bigint [ref: > job.id, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes { (job_id, dev_field_id) [unique] }
}

Enum job_tech_stack_stage {
  basic
  core
}

Table job_tech_stack {
  id bigint [pk, increment]
  stage job_tech_stack_stage [not null]
  job_id bigint [ref: > job.id, not null]              // ON DELETE: RESTRICT (카탈로그 FK)
  tech_stack_id bigint [ref: > tech_stack.id, not null] // ON DELETE: RESTRICT (카탈로그 FK)
  indexes { (job_id, tech_stack_id) [unique] }
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table job_track {                // 직무 상세 "관련 트랙"
  id bigint [pk, increment]
  job_id bigint [ref: > job.id, not null]       // ON DELETE: RESTRICT (카탈로그 FK)
  track_id bigint [ref: > track.id, not null]   // ON DELETE: RESTRICT (카탈로그 FK)
  indexes { (job_id, track_id) [unique] }
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

