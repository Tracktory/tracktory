// ============================================================
// 추천 트랜잭션
// ============================================================
Enum recommendation_trigger_source {
  auto
  manual
}

Enum recommendation_status {
  active      //현재 사용자에게 노출 중인 최신 추천
  superseded  //새 추천으로 대체됨 — 더 이상 메인 노출 X, 마이페이지 이력으로만 조회
  archived    //사용자가 명시적으로 숨김 또는 일정 기간 경과로 자동 보관
}

Table recommendation {           // aggregate root (마이페이지 추천 이력)
  id bigint [pk, increment]
  user_id bigint [ref: > user.id, not null]   // ON DELETE: CASCADE
  status recommendation_status [not null, default: 'active']
  trigger_source recommendation_trigger_source [not null]
  track_combination_score int                          // 조합 시너지 점수 (0~100, recommended_track.score 와 일관)
  track_combination_summary varchar(255)               // "웹 공학 + AI" 같은 한 줄 요약
  track_combination_reasoning text                     // LLM 산출 조합 분석
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table recommended_job {
  id bigint [pk, increment]
  score int [not null]
  reasoning text
  recommendation_id bigint [ref: > recommendation.id, not null]   // ON DELETE: CASCADE (aggregate root 자식 lifecycle)
  job_id bigint [ref: > job.id, not null]                          // ON DELETE: RESTRICT (카탈로그 FK)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes { (recommendation_id, job_id) [unique] }
}

Table recommended_track {
  id bigint [pk, increment]
  score int
  reasoning text
  is_primary boolean [not null]
  recommendation_id bigint [ref: > recommendation.id, not null]   // ON DELETE: CASCADE (aggregate root 자식 lifecycle)
  track_id bigint [ref: > track.id, not null]                      // ON DELETE: RESTRICT (카탈로그 FK)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes { (recommendation_id, track_id) [unique] }
}

Table roadmap {
  id bigint [pk, increment]
  recommendation_id bigint [ref: - recommendation.id, not null]   // ON DELETE: CASCADE (aggregate root 자식 lifecycle)
  reasoning text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes { (recommendation_id) [unique] }
}

Table roadmap_item {
  id bigint [pk, increment]
  roadmap_id bigint [ref: > roadmap.id, not null]    // ON DELETE: CASCADE (aggregate root 자식 lifecycle)
  subject_id bigint [ref: > subject.id, not null]    // ON DELETE: RESTRICT (카탈로그 FK)
  stage subject_stage [not null]
  score decimal(3,2)
  year int [not null]
  semester int [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes { (roadmap_id, subject_id) [unique] }
}

// ============================================================
// 챗봇 - 미포함
// ============================================================
