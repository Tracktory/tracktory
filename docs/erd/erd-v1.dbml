// ============================================================
// 계정
// ============================================================
Table user {
  id int [pk, increment]
}

// ============================================================
// 프로필 (온보딩 결과)
// ============================================================
Table user_profile {
  id bigint [pk, increment]
  user_id bigint [ref: - user.id]   // 1:1
  department_id int [ref: > department.id]  // 소속 (학부)
  student_id char(7) [unique, not null]   // 학번
  current_year tinyint [not null] // 현재 학년 (1~4)
  name varchar(50) [not null] // 이름
  profile_image_url varchar(500)
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]
}

Table user_track {               // User ↔ Track (1트랙/2트랙 — 구분은 필드)
  user_id bigint [ref: > user.id]
  track_id int [ref: > track.id]
  track_order tinyint [not null]
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]
  indexes {
    (user_id, track_id) [pk]
    (user_id, track_order) [unique]
  }
}

Table user_interest {            // User ↔ Interest (1~5)
  user_id bigint [ref: > user.id]
  interest_id int [ref: > interest.id]
  created_at timestamp [default: `now()`, not null]
  indexes { (user_id, interest_id) [pk] }
}

Table user_dev_field {           // User ↔ DevField (1~3)
  user_id bigint [ref: > user.id]
  dev_field_id int [ref: > dev_field.id]
  created_at timestamp [default: `now()`, not null]
  indexes { (user_id, dev_field_id) [pk] }
}

Table user_company_type {        // User ↔ CompanyType
  user_id bigint [ref: > user.id]
  company_type_id int [ref: > company_type.id]
  created_at timestamp [default: `now()`, not null]
  indexes { (user_id, company_type_id) [pk] }
}

Table user_work_value {          // User ↔ WorkValue (최대 3)
  user_id bigint [ref: > user.id]
  work_value_id int [ref: > work_value.id]
  created_at timestamp [default: `now()`, not null]
  indexes { (user_id, work_value_id) [pk] }
}

Table user_tech_stack {          // 공부해본 기술 (UI: Python/Java/...)
  user_id bigint [ref: > user.id]
  tech_stack_id int [ref: > tech_stack.id]
  created_at timestamp [default: `now()`, not null]
  indexes { (user_id, tech_stack_id) [pk] }
}

Table user_tech_stack_custom {  // 자유 입력값
  id int [pk, increment]
  user_id bigint [ref: > user.id]
  label varchar(40) [not null]
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]
  indexes { (user_id, label) [unique] }
}

Table user_completed_subject {   // 이수 과목 (속성 붙음 — 학년/학기)
  id int [pk, increment]
  user_id bigint [ref: > user.id]
  subject_id int [ref: > subject.id]
  year tinyint [not null]
  semester tinyint [not null]
  created_at timestamp [default: `now()`, not null]
  updated_at timestamp [default: `now()`, not null]
  indexes { (user_id, subject_id) [unique] }
}

// ============================================================
// 조직 계층
// ============================================================
Table college {
  id int [pk, increment]
}

Table department {
  id int [pk, increment]
  college_id int [ref: > college.id]
}

Table track {
  id int [pk, increment]
  department_id int [ref: > department.id]
}

// ============================================================
// 교과
// ============================================================
Table subject {
  id int [pk, increment]
}

Table track_subject {            // Track ↔ Subject (필수/선택은 필드)
  track_id int [ref: > track.id]
  subject_id int [ref: > subject.id]
  indexes { (track_id, subject_id) [pk] }
}

Table subject_prerequisite {     // Subject self-ref (선수과목)
  subject_id int [ref: > subject.id]      // 후수
  prerequisite_id int [ref: > subject.id] // 선수
  indexes { (subject_id, prerequisite_id) [pk] }
}

Table subject_job {              // 과목 상세 "관련 직무"
  subject_id int [ref: > subject.id]
  job_id int [ref: > job.id]
  indexes { (subject_id, job_id) [pk] }
}

// ============================================================
// 진로
// ============================================================
Table job {
  id int [pk, increment]
}

Table tech_stack {
  id int [pk, increment]
}

Table job_tech_stack {           // Job ↔ TechStack (필요역량 기본/심화 구분은 필드)
  job_id int [ref: > job.id]
  tech_stack_id int [ref: > tech_stack.id]
  indexes { (job_id, tech_stack_id) [pk] }
}

Table job_track {                // 직무 상세 "관련 트랙"
  job_id int [ref: > job.id]
  track_id int [ref: > track.id]
  indexes { (job_id, track_id) [pk] }
}

// ============================================================
// 분류/카테고리
// ================================== ==========================
Table interest        { // 관심 분야
    id int [pk, increment]
    code varchar(40) [unique, not null]
    created_at timestamp [default: `now()`, not null]
    updated_at timestamp [default: `now()`, not null]
}
Table dev_field       { // 공부해 본 분야
    id int [pk, increment]
    code varchar(40) [unique, not null]
    created_at timestamp [default: `now()`, not null]
    updated_at timestamp [default: `now()`, not null]
}
Table company_type    { // 희망하는 회사 유형
    id int [pk, increment]
    code varchar(40) [unique, not null]
    created_at timestamp [default: `now()`, not null]
    updated_at timestamp [default: `now()`, not null]
}
Table work_value      { // 취업 시 중요 가치
    id int [pk, increment]
    code varchar(40) [unique, not null]
    created_at timestamp [default: `now()`, not null]
    updated_at timestamp [default: `now()`, not null]
}

// ============================================================
// 추천 트랜잭션
// ============================================================
Table recommendation {           // aggregate root (마이페이지 추천 이력)
  id int [pk, increment]
  user_id int [ref: > user.id]
}

Table recommended_job {          // 직무 3~5 + 매칭률(%) — score는 필드
  id int [pk, increment]
  recommendation_id int [ref: > recommendation.id]
  job_id int [ref: > job.id]
}

Table recommended_track {        // 주2 + 보조5 (rank, score는 필드)
  id int [pk, increment]
  recommendation_id int [ref: > recommendation.id]
  track_id int [ref: > track.id]
}

Table roadmap {
  id int [pk, increment]
  recommendation_id int [ref: - recommendation.id]   // 1:1
}

Table roadmap_item {             // 단계 + 순위 + 선수미이수 플래그는 필드
  id int [pk, increment]
  roadmap_id int [ref: > roadmap.id]
  subject_id int [ref: > subject.id]
}

// ============================================================
// 챗봇 - 미포함
// ============================================================
